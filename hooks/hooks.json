{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec|functions\\.exec_command|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/run_push_guard.py",
            "commandWindows": "python ${PLUGIN_ROOT}/hooks/run_push_guard.py",
            "statusMessage": "Checking push-guard review",
            "async": false
          }
        ]
      }
    ]
  }
}
