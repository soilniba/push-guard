{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec|functions\\.exec_command|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/run_push_guard.cmd\"",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/run_push_guard.cmd\"",
            "async": false
          }
        ]
      }
    ]
  }
}
